{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "strict": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "lib": ["ES2023", "DOM", "DOM.Iterable"]
    },
    "include": [
        "./src/scripts"
    ]
}
